BOT_TOKEN=your_bot_token_here

# Вариант 1: готовый ключ авторизации (одной строкой, без переносов)
GIGACHAT_AUTH_KEY=your_gigachat_authorization_key_here

# Вариант 2: Client ID и Client Secret из личного кабинета Sber
GIGACHAT_CLIENT_ID=your_client_id_here
GIGACHAT_CLIENT_SECRET=your_client_secret_here

GIGACHAT_MODEL=GigaChat-2

# ProxyAPI для генерации изображений
PROXY_API=your_proxyapi_key_here
PROXY_API_BASE_URL=https://api.proxyapi.ru/openai/v1
IMAGE_MODEL=gpt-image-2
